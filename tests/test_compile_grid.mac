/* Tests for compile_grid (reactive-views Component 1 / numerics) */

/* === 1. 1D smoke + shape === */

np_shape(compile_grid(sin(x), [[x, 0, %pi, 5]]));
[5];

/* === 2. 1D values: endpoints and midpoint of sin over [0, π] === */

block([vals : np_to_list(compile_grid(sin(x), [[x, 0, %pi, 5]]))],
      [is(abs(vals[1])       < 1e-12),    /* sin(0)   = 0 */
       is(abs(vals[5])       < 1e-12),    /* sin(π)   = 0 (within fp) */
       is(abs(vals[3] - 1.0) < 1e-12)]);  /* sin(π/2) = 1 */
[true, true, true];

/* === 3. 2D shape === */

np_shape(compile_grid(sin(k*x), [[k, 0, 1, 3], [x, 0, %pi, 4]]));
[3, 4];

/* === 4. 2D values: row 0 is k=0 so sin(0*x) = 0 everywhere === */

block([g],
      g : np_to_matrix(compile_grid(sin(k*x),
                                    [[k, 0, 1, 3], [x, 0, %pi, 4]])),
      every(lambda([v], is(abs(v) < 1e-12)),
            first(args(row(g, 1)))));
true;

/* === 5. 3D shape === */

np_shape(compile_grid(x + y + z,
                      [[x, 0, 1, 2], [y, 0, 1, 3], [z, 0, 1, 4]]));
[2, 3, 4];

/* === 6. n = 1 collapses to a single sample === */

np_shape(compile_grid(sin(x), [[x, 0.5, 0.5, 1]]));
[1];

is(abs(np_to_list(compile_grid(sin(x), [[x, 0.5, 0.5, 1]]))[1]
        - sin(0.5)) < 1e-12);
true;

/* === 7. Free variables not in the spec are bound at call time === */

block([a, v],
      a : 2,
      v : np_to_list(compile_grid(a*x, [[x, 0, 1, 3]])),
      [is(abs(v[1])       < 1e-12),     /* 2*0   = 0 */
       is(abs(v[2] - 1.0) < 1e-12),     /* 2*0.5 = 1 */
       is(abs(v[3] - 2.0) < 1e-12)]);   /* 2*1   = 2 */
[true, true, true];

/* === 8. Error path: malformed spec === */

errcatch(compile_grid(sin(x), [x, 0, 1, 5]));            /* not nested */
[];

errcatch(compile_grid(sin(x), [[x, 0, 1]]));             /* missing n */
[];

errcatch(compile_grid(sin(x), [[2, 0, 1, 5]]));          /* non-symbol var */
[];

errcatch(compile_grid(sin(x), [[x, 0, 1, 0]]));          /* n < 1 */
[];

/* === 9. > 3 dimensions errors === */

errcatch(compile_grid(a+b+c+d,
                      [[a, 0, 1, 2], [b, 0, 1, 2],
                       [c, 0, 1, 2], [d, 0, 1, 2]]));
[];
